# Em dev: copie para `.env`. Em produção (Render) defina no painel do
# serviço — não commite o `.env` real. Ver DEPLOY.md para o mapa por serviço.

# ---- PostgreSQL (Docker Compose) ----
POSTGRES_USER=kerno
POSTGRES_PASSWORD=kerno
POSTGRES_DB=kerno

# ---- Prisma / App database connection ----
DATABASE_URL="postgresql://kerno:kerno@localhost:5432/kerno?schema=public"

# ---- Auth (gerar com: openssl rand -base64 32) ----
AUTH_SECRET="change-me"

# ---- App (web — hospeda o Next, a API Hono e o realtime, tudo no mesmo processo) ----
PORT=3000
HOST=localhost
# URL pública do web (NextAuth v5). Local: http://localhost:3000
# Produção: a URL do serviço web (ex.: https://kerno-web.up.railway.app)
AUTH_URL="http://localhost:3000"

# ---- LiveKit (Cloud — projeto "Kerno" em livekit.cloud) ----
# LIVEKIT_URL e NEXT_PUBLIC_LIVEKIT_WS_URL são a MESMA url do projeto (wss://).
# Key/Secret ficam em Manage API keys — o secret só aparece uma vez, na criação.
LIVEKIT_URL="wss://kerno-jjsidker.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_WS_URL="wss://kerno-jjsidker.livekit.cloud"
LIVEKIT_API_KEY="examplekey"
LIVEKIT_API_SECRET="examplesecret"

# ---- LiveKit (alternativa: self-hosted via Docker Compose, sem depender do Cloud) ----
# Só necessário se você trocar de volta pro `docker-compose.yml` local.
# LIVEKIT_API_SECRET precisa ter no mínimo 32 caracteres (o servidor recusa
# secrets curtos). Gere um de verdade em produção: openssl rand -base64 32
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=dev-only-livekit-secret-32chars-minimum
# LIVEKIT_URL="http://localhost:7880"
# NEXT_PUBLIC_LIVEKIT_WS_URL="ws://localhost:7880"